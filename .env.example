# Copy to `.env` (same folder as docker-compose.yml) and adjust.
# docker compose reads this file automatically for ${VAR} substitution.

# ---- host ports the reverse proxy points at ----
WEB_PORT=3021
API_PORT=3022

# ---- sub-path the site is served from ----
# The server has no spare sub-domain, so the app lives under a path: <PUBLIC_WEB_URL>/cms
# BUILD-time value — after changing it you must rebuild, not just restart:
#   docker compose build web && docker compose up -d
# Set to an empty value to serve from the domain root instead.
WEB_BASE_PATH=/cms

# ---- public URLs ----
# PUBLIC_WEB_URL is the ORIGIN only (no path) — the sub-path comes from WEB_BASE_PATH.
# It is also what the API accepts as the CORS origin.
# PUBLIC_API_URL is what the BROWSER calls, so it must be reachable from outside Docker.
#
# Local dev defaults: web http://localhost:3021/cms , api http://localhost:3022/api
#
# Production — API published on its own port (separate containers, no proxy path juggling):
#   PUBLIC_WEB_URL=https://data.lifesystemd.com
#   PUBLIC_API_URL=https://data.lifesystemd.com:3022/api
PUBLIC_WEB_URL=http://localhost:3021
PUBLIC_API_URL=http://localhost:3022/api

# ---- existing database (the API connects to this; it is NOT created by compose) ----
# The api container joins the MySQL stack's own docker network and reaches it by CONTAINER
# NAME, so MYSQL_HOST is that container's name (prod: bs_database) and MYSQL_PORT is its
# INTERNAL port — 3306 — regardless of what it publishes on the host.
# DB_NETWORK must be the name docker really gave the network, not the key in the other
# compose file (compose prefixes it with that project's name). Find it with:
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}' bs_database
DB_NETWORK=xxx_theerasan-network
MYSQL_HOST=bs_database
MYSQL_PORT=3306
MYSQL_DATABASE=cms
MYSQL_USER=admin
MYSQL_PASSWORD=change-me

# Leave false so an existing DB is never reset. Set true only for a brand-new empty DB.
AUTO_SEED=false

# ---- secrets — REQUIRED in production ----
# generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-min-16
NEXTAUTH_SECRET=change-me-to-a-long-random-string
