# Copy to `.env.local` and fill in real values. Never commit the real .env.local.
# API base as seen by the BROWSER
NEXT_PUBLIC_API_URL=http://localhost:3021/api

# Sub-path the app is served from (the server has no sub-domain for it).
# Must be set at BUILD time — it is inlined into the client bundle.
# Use an empty value to serve from the domain root instead.
NEXT_PUBLIC_BASE_PATH=/cms

# With a basePath set, NextAuth needs the full path to its route handler,
# i.e. <origin><basePath>/api/auth — not just the origin.
NEXTAUTH_URL=http://localhost:3000/cms/api/auth
# generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
